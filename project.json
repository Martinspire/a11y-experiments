{
  "$schema": "node_modules/nx/schemas/project-schema.json",
  "cli": {
    "analytics": false,
    "schematicCollections": [
      "@angular-eslint/schematics",
      "@schematics/angular",
      "@ngneat/spectator"
    ]
  },
  "generators": {
    "@ngneat/spectator:spectator-component": {
      "standalone": true,
      "style": "scss"
    },
    "@schematics/angular:component": {
      "standalone": true,
      "style": "scss"
    }
  },
  "name": "a11y-experiments",
  "prefix": "ae",
  "projectType": "application",
  "schematics": {
    "@ngneat/spectator:spectator-component": {
      "standalone": true,
      "style": "scss"
    },
    "@schematics/angular:component": {
      "standalone": true,
      "style": "scss"
    }
  },
  "sourceRoot": "./src",
  "tags": [],
  "targets": {
    "build": {
      "configurations": {
        "development": {
          "extractLicenses": false,
          "optimization": false,
          "sourceMap": true
        },
        "production": {
          "budgets": [
            {
              "maximumError": "5mb",
              "maximumWarning": "2mb",
              "type": "initial"
            },
            {
              "maximumError": "8kb",
              "maximumWarning": "4kb",
              "type": "anyComponentStyle"
            }
          ],
          "optimization": {
            "fonts": true,
            "scripts": true,
            "styles": {
              "inlineCritical": false,
              "minify": true
            }
          },
          "outputHashing": "all"
        }
      },
      "defaultConfiguration": "production",
      "executor": "@angular-devkit/build-angular:application",
      "options": {
        "allowedCommonJsDependencies": [
          "quill"
        ],
        "assets": [
          "./src/favicon.ico",
          "./src/assets"
        ],
        "browser": "./src/main.ts",
        "index": "./src/index.html",
        "inlineStyleLanguage": "scss",
        "outputPath": "dist/a11y-experiments",
        "polyfills": [
          "zone.js"
        ],
        "scripts": [],
        "styles": [
          {
            "bundleName": "lara-dark-blue",
            "inject": false,
            "input": "src/styles/theme/lara-dark-blue.scss"
          },
          {
            "bundleName": "lara-light-blue",
            "inject": false,
            "input": "src/styles/theme/lara-light-blue.scss"
          },
          "node_modules/primeng/resources/primeng.min.css",
          "node_modules/primeflex/primeflex.css",
          "node_modules/primeicons/primeicons.css",
          "./src/styles/styles.scss"
        ],
        "tsConfig": "./tsconfig.app.json"
      },
      "outputs": [
        "{options.outputPath}"
      ]
    },
    "deploy": {
      "executor": "angular-cli-ghpages:deploy",
      "options": {
        "baseHref": "/a11y-experiments/",
        "email": "deploy@martinspire.nl",
        "name": "Deploy Bot"
      }
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "a11y-experiments:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "./src",
          "./e2e/src"
        ]
      }
    },
    "serve": {
      "configurations": {
        "development": {
          "buildTarget": "a11y-experiments:build:development"
        },
        "production": {
          "buildTarget": "a11y-experiments:build:production"
        }
      },
      "defaultConfiguration": "development",
      "executor": "@angular-devkit/build-angular:dev-server",
      "options": {
        "port": 4200
      }
    },
    "stylelint": {
      "executor": "nx-stylelint:lint",
      "options": {
        "formatter": "compact",
        "lintFilePatterns": [
          "**/*.scss"
        ]
      },
      "outputs": [
        "{options.outputFile}"
      ]
    },
    "test": {
      "executor": "@nx/jest:jest",
      "options": {
        "jestConfig": "jest.config.ts"
      },
      "outputs": [
        "{workspaceRoot}/coverage/{projectName}"
      ]
    }
  }
}
